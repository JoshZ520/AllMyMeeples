<div class="admin-header">
  <h1>Manage Games</h1>
  <a href="/admin/games/new" class="button primary">Add New Game</a>
</div>

<div class="admin-stats">
  <div class="stat-card">
    <p class="stat-label">Total Games</p>
    <p class="stat-value"><%= games.length %></p>
  </div>
</div>

<div class="admin-section">
  <h2>All Games</h2>
  
  <% if (games.length === 0) { %>
    <p>No games found. <a href="/admin/games/new">Add your first game</a>.</p>
  <% } else { %>
    <div class="games-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Players</th>
            <th>Playtime</th>
            <th>Rating</th>
            <th>Categories</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% games.forEach(game => { %>
            <tr>
              <td>
                <strong><%= game.title %></strong>
              </td>
              <td><%= game.min_players %>-<%= game.max_players %></td>
              <td><%= game.playtime_minutes %> min</td>
              <td><%= game.rating || 'N/A' %></td>
              <td>
                <% if (game.categories && game.categories.length > 0) { %>
                  <%= game.categories.join(', ') %>
                <% } else { %>
                  <span class="text-muted">None</span>
                <% } %>
              </td>
              <td class="actions">
                <a href="/admin/games/<%= game.id %>/edit" class="button secondary small">Edit</a>
                <form method="POST" action="/admin/games/<%= game.id %>/delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this game? This action cannot be undone.');">
                  <button type="submit" class="button danger small">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<style>
.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
}

.admin-header h1 {
  margin: 0;
}

.admin-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
  margin-bottom: 2rem;
}

.stat-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1.5rem;
}

.stat-label {
  margin: 0 0 0.5rem;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--muted);
}

.stat-value {
  margin: 0;
  font-size: 2rem;
  font-weight: 600;
  color: var(--accent);
}

.admin-section {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 2rem;
  margin-bottom: 2rem;
}

.admin-section h2 {
  margin: 0 0 1.5rem;
  font-size: 1.5rem;
  color: var(--ink);
}

.games-table-container {
  overflow-x: auto;
}

.admin-table {
  width: 100%;
  border-collapse: collapse;
}

.admin-table th,
.admin-table td {
  padding: 1rem;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

.admin-table th {
  background: var(--paper);
  font-weight: 600;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--muted);
}

.admin-table tbody tr:hover {
  background: var(--paper);
}

.admin-table td.actions {
  white-space: nowrap;
}

.button.small {
  padding: 0.4rem 0.8rem;
  font-size: 0.85rem;
}

.button.danger {
  background: #dc3545;
  color: white;
  border-color: #dc3545;
}

.button.danger:hover {
  background: #c82333;
  border-color: #bd2130;
}

.text-muted {
  color: var(--muted);
  font-style: italic;
}
</style>
