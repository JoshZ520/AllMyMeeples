<div class="form-container">
  <div class="form-header">
    <h1><%= game ? 'Edit Game' : 'Add New Game' %></h1>
    <a href="/admin/games" class="button secondary">Back to Games</a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
      <%= error %>
    </div>
  <% } %>

  <form method="POST" action="<%= action %>" class="admin-form">
    <div class="form-grid">
      <div class="form-group">
        <label for="title">Title <span class="required">*</span></label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          value="<%= game ? game.title : '' %>" 
          required
          placeholder="e.g., Catan"
        >
      </div>

      <div class="form-group">
        <label for="image_url">Image URL</label>
        <input 
          type="text" 
          id="image_url" 
          name="image_url" 
          value="<%= game ? game.image_url : '' %>"
          placeholder="https://example.com/image.jpg"
        >
      </div>

      <div class="form-group full-width">
        <label for="description">Description <span class="required">*</span></label>
        <textarea 
          id="description" 
          name="description" 
          rows="4" 
          required
          placeholder="Describe the game..."
        ><%= game ? game.description : '' %></textarea>
      </div>

      <div class="form-group">
        <label for="min_players">Min Players <span class="required">*</span></label>
        <input 
          type="number" 
          id="min_players" 
          name="min_players" 
          value="<%= game ? game.min_players : '' %>" 
          min="1"
          required
          placeholder="e.g., 2"
        >
      </div>

      <div class="form-group">
        <label for="max_players">Max Players <span class="required">*</span></label>
        <input 
          type="number" 
          id="max_players" 
          name="max_players" 
          value="<%= game ? game.max_players : '' %>" 
          min="1"
          required
          placeholder="e.g., 4"
        >
      </div>

      <div class="form-group">
        <label for="playtime_minutes">Playtime (minutes) <span class="required">*</span></label>
        <input 
          type="number" 
          id="playtime_minutes" 
          name="playtime_minutes" 
          value="<%= game ? game.playtime_minutes : '' %>" 
          min="1"
          required
          placeholder="e.g., 60"
        >
      </div>

      <div class="form-group">
        <label for="rating">Rating (1-5)</label>
        <input 
          type="number" 
          id="rating" 
          name="rating" 
          value="<%= game ? game.rating : '' %>" 
          min="0"
          max="5"
          step="0.1"
          placeholder="e.g., 4.5"
        >
      </div>

      <div class="form-group full-width">
        <label for="categories">Categories</label>
        <input 
          type="text" 
          id="categories" 
          name="categories" 
          value="<%= game ? game.categoriesString : '' %>"
          placeholder="e.g., Strategy, Family (comma-separated)"
        >
        <small class="form-hint">Enter categories separated by commas</small>
      </div>

      <div class="form-group full-width">
        <label for="mechanics">Mechanics</label>
        <input 
          type="text" 
          id="mechanics" 
          name="mechanics" 
          value="<%= game ? game.mechanicsString : '' %>"
          placeholder="e.g., Dice Rolling, Card Drafting (comma-separated)"
        >
        <small class="form-hint">Enter mechanics separated by commas</small>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="button primary">
        <%= game ? 'Update Game' : 'Create Game' %>
      </button>
      <a href="/admin/games" class="button secondary">Cancel</a>
    </div>
  </form>
</div>

<style>
.form-container {
  max-width: 900px;
  margin: 0 auto;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
}

.form-header h1 {
  margin: 0;
}

.alert {
  padding: 1rem;
  border-radius: 6px;
  margin-bottom: 1.5rem;
}

.alert-error {
  background: #f8d7da;
  color: #721c24;
  border: 1px solid #f5c6cb;
}

.admin-form {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 2rem;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.form-group {
  display: flex;
  flex-direction: column;
}

.form-group.full-width {
  grid-column: 1 / -1;
}

.form-group label {
  margin-bottom: 0.5rem;
  font-weight: 600;
  color: var(--ink);
}

.required {
  color: #dc3545;
}

.form-group input,
.form-group textarea {
  padding: 0.75rem;
  border: 1px solid var(--border);
  border-radius: 6px;
  font-family: inherit;
  font-size: 1rem;
  background: var(--card);
  color: var(--ink);
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(139, 91, 52, 0.1);
}

.form-hint {
  margin-top: 0.25rem;
  font-size: 0.85rem;
  color: var(--muted);
}

.form-actions {
  display: flex;
  gap: 1rem;
  justify-content: flex-start;
}

@media (max-width: 768px) {
  .form-grid {
    grid-template-columns: 1fr;
  }
  
  .form-header {
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
}
</style>
