<section class="section">
  <div class="section-header">
    <h2><%= user.role === 'moderator' ? 'Moderator' : 'Admin' %> Dashboard</h2>
    <p>Manage <%= user.role === 'admin' ? 'users, games, and reviews' : 'reviews' %>.</p>
  </div>

  <% if (user.role === 'admin') { %>
  <div class="admin-nav">
    <a href="/admin/games" class="button primary">Manage Games</a>
  </div>
  <% } %>

  <% if (typeof error !== 'undefined') { %>
    <p class="form-error"><%= error %></p>
  <% } %>

  <% if (user.role === 'admin') { %>
  <div class="card-grid">
    <% users.forEach(user => { %>
      <article class="card">
        <h3><%= user.name %></h3>
        <p><strong>Email:</strong> <%= user.email %></p>
        <p><strong>Role:</strong> <%= user.role %></p>
        <p><strong>Member since:</strong> <%= new Date(user.created_at).toLocaleDateString() %></p>

        <form method="post" action="/admin/users/<%= user.id %>/role" class="auth-form">
          <div class="form-group">
            <label for="role-<%= user.id %>">Change role</label>
            <select id="role-<%= user.id %>" name="role">
              <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>User</option>
              <option value="moderator" <%= user.role === 'moderator' ? 'selected' : '' %>>Moderator</option>
              <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
            </select>
          </div>
          <button type="submit" class="button primary full-width">Update Role</button>
        </form>
      </article>
    <% }); %>
  </div>
  <% } %>
</section>

<section class="section">
  <div class="section-header">
    <h2>Pending Reviews</h2>
    <p>Approve or reject newly submitted reviews.</p>
  </div>

  <% if (pendingReviews.length === 0) { %>
    <p>No pending reviews.</p>
  <% } else { %>
    <div class="card-grid">
      <% pendingReviews.forEach(review => { %>
        <article class="card">
          <h3><%= review.game_title %></h3>
          <p><strong>Reviewer:</strong> <%= review.name %> (<%= review.email %>)</p>
          <p><strong>Rating:</strong> ⭐ <%= review.rating %></p>
          <p><%= review.content %></p>
          <div class="review-actions">
            <form method="post" action="/admin/reviews/<%= review.id %>/status">
              <input type="hidden" name="status" value="approved">
              <button type="submit" class="button primary">Approve</button>
            </form>
            <form method="post" action="/admin/reviews/<%= review.id %>/status">
              <input type="hidden" name="status" value="rejected">
              <button type="submit" class="button secondary">Reject</button>
            </form>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>

<style>
.admin-nav {
  display: flex;
  gap: 1rem;
  margin-bottom: 2rem;
}

.review-actions {
  display: flex;
  gap: 0.5rem;
  margin-top: 1rem;
}

.review-actions form {
  margin: 0;
}

.review-actions button {
  padding: 0.5rem 1rem;
  font-size: 0.9rem;
}
</style>
