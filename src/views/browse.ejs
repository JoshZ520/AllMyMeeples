<section class="section">
  <div class="browse-header">
    <h1>Browse All Games</h1>
    <button id="toggle-filters" class="button secondary">Show Filters</button>
  </div>

  <div class="browse-summary">
    <% if (user) { %>
      <div class="summary-card">
        <p class="summary-label">Your collection</p>
        <p id="collection-count" class="summary-value">--</p>
      </div>
    <% } else { %>
      <div class="summary-card summary-muted">
        <p class="summary-label">Your collection</p>
        <p class="summary-value">Log in to see your collection count and owned games.</p>
      </div>
    <% } %>
  </div>

  <div id="filters-container" class="browse-filters" style="display: none;">
    <div class="filter-group">
      <label for="search-games">Search</label>
      <input type="search" id="search-games" name="search" placeholder="Search by title or description" />
    </div>
    <div class="filter-group">
      <label for="filter-players">Players</label>
      <select id="filter-players" name="players">
        <option value="">Any</option>
        <option value="1">1+</option>
        <option value="2">2+</option>
        <option value="3">3+</option>
        <option value="4">4+</option>
        <option value="5">5+</option>
        <option value="6">6+</option>
      </select>
    </div>
    <div class="filter-group">
      <label for="filter-playtime">Playtime</label>
      <select id="filter-playtime" name="playtime">
        <option value="">Any</option>
        <option value="30">Up to 30 min</option>
        <option value="45">Up to 45 min</option>
        <option value="60">Up to 60 min</option>
        <option value="90">Up to 90 min</option>
        <option value="120">Up to 120 min</option>
      </select>
    </div>
    <div class="filter-group">
      <label for="filter-category">Category</label>
      <select id="filter-category" name="category">
        <option value="">Any</option>
        <option value="Strategy">Strategy</option>
        <option value="Family">Family</option>
        <option value="Party">Party</option>
        <option value="Card Game">Card Game</option>
        <option value="Cooperative">Cooperative</option>
        <option value="Fantasy">Fantasy</option>
        <option value="Science Fiction">Science Fiction</option>
        <option value="Abstract">Abstract</option>
        <option value="Adventure">Adventure</option>
        <option value="Horror">Horror</option>
      </select>
    </div>
    <div class="filter-group">
      <label for="filter-mechanic">Mechanic</label>
      <select id="filter-mechanic" name="mechanic">
        <option value="">Any</option>
        <option value="Dice Rolling">Dice Rolling</option>
        <option value="Card Drafting">Card Drafting</option>
        <option value="Engine Building">Engine Building</option>
        <option value="Set Collection">Set Collection</option>
        <option value="Hand Management">Hand Management</option>
        <option value="Worker Placement">Worker Placement</option>
        <option value="Area Control">Area Control</option>
        <option value="Deck Building">Deck Building</option>
        <option value="Tile Placement">Tile Placement</option>
        <option value="Deduction">Deduction</option>
        <option value="Route Building">Route Building</option>
        <option value="Trading">Trading</option>
      </select>
    </div>
    <div class="filter-group">
  <label for="sort-by">Sort</label>
  <select id="sort-by" name="sort">
    <option value="title-asc">Title (A-Z)</option>
    <option value="title-desc">Title (Z-A)</option>
    <option value="rating-desc">Rating (high → low)</option>
    <option value="playtime-asc" selected>Playtime (short → long)</option>
    <option value="playtime-desc">Playtime (long → short)</option>
  </select>
</div>
  </div>

  <div id="bulk-actions" class="bulk-actions" style="display: none;">
    <span><strong id="selected-count">0</strong> selected</span>
    <button id="bulk-add" class="button primary">Add selected to shelf</button>
  </div>

  <div id="pagination-top"></div>

  <div id="games-container" class="card-grid">
    <p class="card-grid-loading">Loading games...</p>
  </div>

  <div id="pagination-bottom"></div>
</section>

<script src="/js/browse.js"></script>
